# Acoustic Test Room — 12m x 12m x 10m
#
# Passt zu input_config.json:
#   speaker_position: [2.0, 3.0, 1.5]   -> innerhalb des Raums
#   mic_position:     [8.0, 7.0, 6.0]   -> innerhalb des Raums
#   mic_radius:       3.0               -> kein Wanddurchbruch
#
# Koordinatensystem:
#   x = links/rechts  (0 bis 12)
#   y = vorne/hinten  (0 bis 12)
#   z = Höhe          (0 bis 10)
#
# 8 Ecken, 6 Wände, je 2 Dreiecke pro Wand = 12 Dreiecke gesamt

# Vertices (Ecken)
v  0.0   0.0   0.0
v 12.0   0.0   0.0
v 12.0  12.0   0.0
v  0.0  12.0   0.0
v  0.0   0.0  10.0
v 12.0   0.0  10.0
v 12.0  12.0  10.0
v  0.0  12.0  10.0

# Faces (Dreiecke)
# Boden (z = 0)
f 1 2 3
f 1 3 4

# Decke (z = 10)
f 5 6 7
f 5 7 8

# Wand vorne (y = 0)
f 1 2 6
f 1 6 5

# Wand hinten (y = 12)
f 4 3 7
f 4 7 8

# Wand links (x = 0)
f 1 4 8
f 1 8 5

# Wand rechts (x = 12)
f 2 3 7
f 2 7 6
